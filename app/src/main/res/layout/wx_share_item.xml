<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#212121"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12sp"
            android:textColor="#8A8A8A" />
    </LinearLayout>

    <TextView
        android:id="@+id/item_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="44dp"
        android:minHeight="44dp"
        android:gravity="center"
        android:text="@string/wxchat_item_copy"
        android:textSize="13sp"
        android:textColor="#1565C0"
        android:contentDescription="@string/wxchat_item_copy" />

    <TextView
        android:id="@+id/item_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="44dp"
        android:minHeight="44dp"
        android:gravity="center"
        android:text="@string/asr_item_result"
        android:textSize="13sp"
        android:textColor="#212121"
        android:contentDescription="@string/asr_item_result" />
</LinearLayout>
