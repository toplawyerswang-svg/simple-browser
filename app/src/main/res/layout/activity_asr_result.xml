<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F6F1">

    <TextView
        android:id="@+id/asr_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/asr_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:textColor="#8A8A8A" />

    <!-- 关键词搜索：高亮命中 + 上下跳转，与分享网页行为一致 -->
    <LinearLayout
        android:id="@+id/asr_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_search_input">

        <EditText
            android:id="@+id/asr_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/asr_content_search_hint"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textColorHint="#B0AEA6" />

        <TextView
            android:id="@+id/asr_search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#8A8A8A" />

        <Button
            android:id="@+id/asr_search_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="38dp"
            android:minHeight="38dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/asr_search_prev"
            android:textSize="14sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/asr_search_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="38dp"
            android:minHeight="38dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/asr_search_next"
            android:textSize="14sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/asr_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        app:tabIndicatorColor="#1565C0"
        app:tabSelectedTextColor="#1565C0"
        app:tabTextColor="#666666" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 标签1：识别结果 -->
        <ScrollView
            android:id="@+id/page_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <Button
                    android:id="@+id/asr_toggle_lang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="36dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/asr_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </ScrollView>

        <!-- 标签2：AI 摘要与待办 -->
        <ScrollView
            android:id="@+id/page_ai"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/asr_ai_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF">

        <!-- 四按钮并排：MaterialButton 默认 12dp 横向 inset 归零，窄屏才放得下四个汉字标签 -->
        <Button
            android:id="@+id/asr_btn_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_copy"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/asr_btn_move_folder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_move_folder"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/asr_btn_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_share"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/asr_btn_share_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_share_link"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />
    </LinearLayout>
</LinearLayout>
