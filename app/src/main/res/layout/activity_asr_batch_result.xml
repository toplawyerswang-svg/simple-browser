<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F6F1">

    <TextView
        android:id="@+id/batch_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#212121" />

    <TextView
        android:id="@+id/batch_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:textColor="#C62828"
        android:visibility="gone" />

    <ListView
        android:id="@+id/asr_batch_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF">

        <!-- 四按钮并排：MaterialButton 默认 12dp 横向 inset 归零，窄屏才放得下四个汉字标签 -->
        <Button
            android:id="@+id/asr_btn_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_copy"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/asr_btn_move_folder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_move_folder"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/asr_btn_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_share"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />

        <Button
            android:id="@+id/asr_btn_share_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:maxLines="1"
            android:padding="0dp"
            android:text="@string/asr_btn_share_link"
            android:textSize="13sp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />
    </LinearLayout>
</LinearLayout>
