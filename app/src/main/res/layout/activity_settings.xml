<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/settings_title"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/settings_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:tabIndicatorColor="#1565C0"
        app:tabSelectedTextColor="#1565C0"
        app:tabTextColor="#666666" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 标签1：其他设置 -->
        <ScrollView
            android:id="@+id/page_other"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/hideControlsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setting_hide_controls" />

                <!-- 广告拦截（F-14） -->
                <TextView
                    android:id="@+id/adBlockSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/setting_adblock_section"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="#1565C0" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/adBlockSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setting_adblock_switch" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/adBlockAutoHideSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setting_adblock_autohide" />

                <TextView
                    android:id="@+id/adBlockWhitelistRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/setting_adblock_whitelist"
                    android:textAppearance="?attr/textAppearanceListItem" />

                <TextView
                    android:id="@+id/adBlockUpdateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/setting_adblock_update_rules"
                    android:textAppearance="?attr/textAppearanceListItem" />

                <TextView
                    android:id="@+id/adBlockRulesStatusTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/adBlockTotalTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="#666666" />

                <!-- 搜索与主页（F-15） -->
                <TextView
                    android:id="@+id/searchSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/setting_section_search"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="#1565C0" />

                <TextView
                    android:id="@+id/searchEngineRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/setting_search_engine"
                    android:textAppearance="?attr/textAppearanceListItem" />

                <TextView
                    android:id="@+id/searchEngineStatusTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/homePageRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/setting_home_page"
                    android:textAppearance="?attr/textAppearanceListItem" />

                <TextView
                    android:id="@+id/homePageStatusTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="#666666" />

                <!-- 浏览体验（F-15） -->
                <TextView
                    android:id="@+id/browseSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/setting_section_browse"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="#1565C0" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/dataSaverSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setting_data_saver" />

                <TextView
                    android:id="@+id/dataSaverHintTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/setting_data_saver_hint"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/textZoomRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/setting_text_zoom"
                    android:textAppearance="?attr/textAppearanceListItem" />

                <TextView
                    android:id="@+id/textZoomStatusTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="#666666" />

                <!-- 隐私（F-15） -->
                <TextView
                    android:id="@+id/privacySectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/setting_section_privacy"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="#1565C0" />

                <TextView
                    android:id="@+id/clearBrowsingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/setting_clear_browsing"
                    android:textAppearance="?attr/textAppearanceListItem" />

                <LinearLayout
                    android:id="@+id/usageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_glass_rounded"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="双指下滑手势"
                        android:src="@drawable/ic_gesture_two_finger_swipe"
                        app:tint="?android:attr/textColorPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="在屏幕任意位置双指下滑，即可快速打开或关闭设置页面。"
                        android:textAppearance="?attr/textAppearanceBody2" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 标签2：下载管理 -->
        <ScrollView
            android:id="@+id/page_downloads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/downloadsTitleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/downloads_section_title"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_download_manage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:text="@string/download_batch_manage" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/download_selection_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/cb_download_select_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download_select_all"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btn_download_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/download_delete" />

                    <Button
                        android:id="@+id/btn_download_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/download_cancel_selection" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/downloadsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/versionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </ScrollView>

        <!-- 标签3：音视频识别 -->
        <LinearLayout
            android:id="@+id/page_asr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#F7F6F1"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/asr_auth_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/asr_manage_auth_hint"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <EditText
                    android:id="@+id/asr_token_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/asr_token_input_hint"
                    android:inputType="text"
                    android:maxLines="3" />

                <Button
                    android:id="@+id/asr_token_verify_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/asr_token_verify" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/asr_content_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:id="@+id/asr_identity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/asr_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/asr_manage_refresh" />

                    <Button
                        android:id="@+id/asr_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/asr_manage_switch" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="6dp"
                    android:text="@string/asr_manage_play_hint"
                    android:textSize="12sp"
                    android:textColor="#8A8A8A" />

                <!-- 资料夹入口：录音与聊天记录跨类归组，支持整体分享 -->
                <LinearLayout
                    android:id="@+id/asr_folder_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📁"
                        android:textSize="20sp"
                        android:contentDescription="@string/folder_title" />

                    <TextView
                        android:id="@+id/asr_folder_entry_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/folder_entry_desc"
                        android:textSize="14sp"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="20sp"
                        android:textColor="#C0C0C0" />
                </LinearLayout>

                <!-- 关键词搜索：本地过滤当前列表（多选模式下隐藏） -->
                <EditText
                    android:id="@+id/asr_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:hint="@string/asr_search_hint"
                    android:textColor="#212121"
                    android:textColorHint="#8A8A8A"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textSize="14sp" />

                <!-- 多选操作栏：长按记录选「多选」进入；上行计数+完成，下行四个批量操作 -->
                <LinearLayout
                    android:id="@+id/asr_selection_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/asr_sel_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:textColor="#1565C0" />

                        <Button
                            android:id="@+id/asr_sel_done"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="13sp"
                            android:text="@string/folder_done" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <!-- 四按钮并排：归零 MaterialButton 横向 inset，窄屏不换行 -->
                        <Button
                            android:id="@+id/asr_sel_move"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="12sp"
                            android:text="@string/folder_move_to"
                            android:insetLeft="0dp"
                            android:insetRight="0dp" />

                        <Button
                            android:id="@+id/asr_sel_copy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="12sp"
                            android:text="@string/asr_btn_copy"
                            android:insetLeft="0dp"
                            android:insetRight="0dp" />

                        <Button
                            android:id="@+id/asr_sel_share"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="12sp"
                            android:text="@string/asr_btn_share"
                            android:insetLeft="0dp"
                            android:insetRight="0dp" />

                        <Button
                            android:id="@+id/asr_sel_share_link"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:textSize="12sp"
                            android:text="@string/asr_btn_share_link"
                            android:insetLeft="0dp"
                            android:insetRight="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <ListView
                    android:id="@+id/asr_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp"
                    android:divider="@null" />

                <TextView
                    android:id="@+id/asr_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/asr_manage_empty"
                    android:textSize="14sp"
                    android:textColor="#8A8A8A"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 标签4：聊天记录分享 -->
        <LinearLayout
            android:id="@+id/page_wxchat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#F7F6F1"
            android:visibility="gone">

            <TextView
                android:id="@+id/wxchat_auth_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="@string/wxchat_manage_auth_hint"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/wxchat_content_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:id="@+id/wxchat_identity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/wxchat_names_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/wxchat_names_btn" />

                    <Button
                        android:id="@+id/wxchat_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/asr_manage_refresh" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="6dp"
                    android:text="@string/wxchat_manage_hint"
                    android:textSize="12sp"
                    android:textColor="#8A8A8A" />

                <!-- 资料夹入口（与音视频识别页签共用同一套文件夹） -->
                <LinearLayout
                    android:id="@+id/wxchat_folder_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📁"
                        android:textSize="20sp"
                        android:contentDescription="@string/folder_title" />

                    <TextView
                        android:id="@+id/wxchat_folder_entry_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/folder_entry_desc"
                        android:textSize="14sp"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="20sp"
                        android:textColor="#C0C0C0" />
                </LinearLayout>

                <!-- 关键词搜索：本地过滤当前列表（多选模式下隐藏） -->
                <EditText
                    android:id="@+id/wxchat_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:hint="@string/wxchat_search_hint"
                    android:textColor="#212121"
                    android:textColorHint="#8A8A8A"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textSize="14sp" />

                <!-- 多选操作栏：长按记录选「多选」进入 -->
                <LinearLayout
                    android:id="@+id/wxchat_selection_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/wxchat_sel_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="#1565C0" />

                    <Button
                        android:id="@+id/wxchat_sel_move"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/folder_move_to" />

                    <Button
                        android:id="@+id/wxchat_sel_done"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:text="@string/folder_done" />
                </LinearLayout>

                <ListView
                    android:id="@+id/wxchat_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp"
                    android:divider="@null" />

                <TextView
                    android:id="@+id/wxchat_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/wxchat_manage_empty"
                    android:textSize="14sp"
                    android:textColor="#8A8A8A"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

    <!-- 聊天记录分享页内预览：全屏 WebView，返回键关闭回到列表 -->
    <FrameLayout
        android:id="@+id/wx_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />
</FrameLayout>
