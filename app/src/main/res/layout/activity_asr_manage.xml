<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F6F1">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:text="@string/asr_manage_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#212121" />

    <!-- 未激活：输入令牌 -->
    <LinearLayout
        android:id="@+id/asr_auth_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/asr_manage_auth_hint"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <EditText
            android:id="@+id/asr_token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/asr_token_input_hint"
            android:inputType="text"
            android:maxLines="3" />

        <Button
            android:id="@+id/asr_token_verify_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/asr_token_verify" />
    </LinearLayout>

    <!-- 已激活：任务管理 -->
    <LinearLayout
        android:id="@+id/asr_content_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/asr_identity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:textStyle="bold" />

            <Button
                android:id="@+id/asr_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp"
                android:text="@string/asr_manage_refresh" />

            <Button
                android:id="@+id/asr_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp"
                android:text="@string/asr_manage_switch" />
        </LinearLayout>

        <ListView
            android:id="@+id/asr_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null" />

        <TextView
            android:id="@+id/asr_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/asr_manage_empty"
            android:textSize="14sp"
            android:textColor="#8A8A8A"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
